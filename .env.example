# Discord Bot Configuration
# Copy this file to .env and replace with your actual bot token
# Get your token from: https://discord.com/developers/applications

DISCORD_BOT_TOKEN=your_bot_token_here

# --- Optional -------------------------------------------------------------

# The upload ceiling is read per message from the server's boost tier
# (Guild.filesize_limit: 10MiB at tier 0/1, 50MiB at tier 2, 100MiB at tier 3).
# Set this only to cap uploads BELOW what the server would actually allow.
# 0 = use the server's real limit.
#MAX_FILE_SIZE_MB=0

# How many downloads/encodes may run at once.
#MAX_CONCURRENT_JOBS=2

# Skip videos longer than this many seconds (0 disables the check).
# Stops someone posting a feature-length video the bot can never compress.
#MAX_DURATION_SECONDS=900

# Attach a rich embed (caption, author, engagement stats) to each repost.
#ENABLE_EMBEDS=true

# Add the poster frame as an embed thumbnail. Off by default because it
# duplicates the video that is already attached.
#ENABLE_EMBED_THUMBNAIL=false

# Caption length before truncation.
#EMBED_DESCRIPTION_LIMIT=400

# Cookies for login-gated platforms. Required for Reddit, which otherwise
# serves anonymous requests a "prove your humanity" challenge; also helps with
# age-restricted X posts and rate-limited Instagram.
# Set at most ONE of these. Treat the cookie file as a credential.
#YTDL_COOKIES_FILE=/app/cookies.txt
#YTDL_COOKIES_FROM_BROWSER=firefox
